{
  "name": "@thimar/turborepo-remote-cache",
  "version": "1.16.1",
  "description": "Self hosted Turborepo remote cache",
  "keywords": [
    "turborepo",
    "remote-cache",
    "monorepo",
    "react-router"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "docker": "docker-compose -f docker-compose.db.yml up -d",
    "lint": "eslint ./app --color --max-warnings=0",
    "postinstall": "prisma generate",
    "setup": "prisma migrate dev && prisma db seed",
    "test": "vitest",
    "typecheck": "react-router typegen && tsc -b && tsc -b prisma",
    "validate": "run-p \"test -- --run\" lint typecheck",
    "prestart": "prisma migrate deploy && prisma db seed",
    "start": "cross-env NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-router/node": "7.18.2",
    "@tanstack/react-table": "9.0.0",
    "abstract-blob-store": "3.3.5",
    "aws-sdk": "2.1693.0",
    "azure-blob-storage": "4.2.5",
    "azure-blob-store": "1.0.7",
    "classnames": "2.5.1",
    "cli-truncate": "6.1.1",
    "copy-to-clipboard": "4.0.2",
    "cross-env": "10.1.0",
    "debug": "4.4.3",
    "domain-functions": "3.3.0",
    "fs-blob-store": "6.0.0",
    "isbot": "5.2.1",
    "koa": "^3.2.1",
    "koa-static": "^5.0.0",
    "npm-run-all": "4.1.5",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "prop-types": "15.8.1",
    "react": "19.2.8",
    "react-charts": "3.0.0-beta.57",
    "react-dom": "19.2.8",
    "react-gravatar": "2.6.3",
    "react-hook-form": "7.84.0",
    "react-intersection-observer": "11.0.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "remix-auth": "4.2.0",
    "remix-auth-form": "3.0.0",
    "remix-auth-microsoft": "^3.0.1",
    "remix-auth-oauth2": "3.4.1",
    "remix-forms": "4.0.0",
    "remix-utils": "^10.0.0",
    "s3-blob-store": "4.1.1",
    "superjson": "2.2.6",
    "tiny-invariant": "1.3.3",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.23.9",
    "typescript": "6.0.3",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/debug": "4.1.13",
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.4",
    "@types/qs": "6.15.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-gravatar": "2.6.14",
    "@types/readable-stream": "4.0.24",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "5.7.47",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "happy-dom": "20.11.1",
    "tailwind": "4.0.0",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cli-truncate": "6.1.1"
  },
  "prisma": {
    "seed": "tsx ./prisma/seed.ts"
  }
}
